# ---------------------------------------------------------------------------
# Listen port
# ---------------------------------------------------------------------------

# Port the dashboard listens on. (default: 8000)
# Docker: port exposed on the host machine (container always listens on 8000 internally).
# Bare-metal: port uvicorn binds to.
# HOST_PORT=8000

# ---------------------------------------------------------------------------
# Receiver connection (REQUIRED)
# ---------------------------------------------------------------------------

# Hostname or IP address of the device running readsb / dump1090-fa (required)
BEAST_HOST=localhost

# Beast TCP output port — readsb/dump1090-fa default is 30005 (required)
BEAST_PORT=30005

# ---------------------------------------------------------------------------
# MLAT streams (optional)
# ---------------------------------------------------------------------------

# Comma-separated list of MLAT Beast stream entries.
# Two formats per entry:
#   Name@host:port   — explicit host (use when MLAT server is on a different host)
#   Name:port        — host defaults to BEAST_HOST
# The Name appears in the MLAT badge tooltip in the live table.
# Example: MLAT_SERVERS=ADSBx@adsbpi:30158,FlightAware:30105,Airplanes:30157
# MLAT_SERVERS=

# Legacy single-server MLAT settings (use MLAT_SERVERS instead for multiple sources)
# MLAT_HOST=
# MLAT_PORT=30105

# ---------------------------------------------------------------------------
# Receiver location (strongly recommended)
# ---------------------------------------------------------------------------

# Receiver latitude in decimal degrees — enables range/bearing, polar chart, coverage map
# RECEIVER_LAT=51.5

# Receiver longitude in decimal degrees
# RECEIVER_LON=-0.1

# Receiver altitude. Accepts feet (e.g. 106ft), metres (e.g. 32m), or a bare number (feet).
# Used for terrain profile calculations. Default: 0
# RECEIVER_ALT_FT=0

# Remove aircraft from the live table after this many seconds without a message
AIRCRAFT_TIMEOUT=60

# Your home country — military aircraft from other countries are flagged "foreign military"
HOME_COUNTRY=United Kingdom

# Aircraft seen in fewer than this many distinct sessions (gap > 1hr) are flagged "rare"
RARE_THRESHOLD=5

# How many days to keep per-minute data before pruning (daily rollups are kept forever)
MINUTE_STATS_RETENTION_DAYS=30

# SQLite database path (default: backend/data/adsb.db)
# DB_PATH=data/adsb.db

# Nightly backup — set BACKUP_PATH to a directory to enable.
# One file per day named adsb_backup_YYYY-MM-DD.db; runs at local midnight.
# BACKUP_PATH=/path/to/backup/dir
# BACKUP_RETAIN=7

# Minimum messages before an aircraft is written to the registry.
# Filters bogus ICAO addresses from CRC decoding errors. Set 0 to disable.
# A confirmed ADSBExchange or hexdb hit bypasses this check regardless.
# GHOST_FILTER_MSGS=2

# Maximum range from receiver accepted for ADS-B positions (nautical miles).
# Mirrors readsb receiver_range. 300 nm is the typical ADS-B horizon.
# MAX_RANGE_NM=300

# Enable verbose enrichment logging (new aircraft lookups, hexdb outcomes)
# DEBUG_ENRICHMENT=true

# Enable verbose debug logging across the whole application (default: false)
# DEBUG_LOG=false

# ---------------------------------------------------------------------------
# Network / server
# ---------------------------------------------------------------------------

# Comma-separated list of extra origins to allow via CORS (default: Vite dev server only).
# Not needed in production — the backend serves the frontend from the same origin.
# CORS_ORIGINS=http://localhost:5173

# Per-client WebSocket send timeout in seconds. Stalled clients are disconnected. (default: 2.0)
# WS_SEND_TIMEOUT_S=2.0

# ---------------------------------------------------------------------------
# Pi 4 / SD card tuning (safe defaults — uncomment to override)
# ---------------------------------------------------------------------------

# SQLite fsync mode. NORMAL is safe with WAL and reduces SD card wear.
# Use FULL only if the Pi has an unreliable power supply. (default: NORMAL)
# SQLITE_SYNCHRONOUS=NORMAL

# How often to recalculate aircraft type rarity (seconds).
# The rare flag changes only when a new type appears — daily is sufficient.
# 21600=6h (default), 3600=1h, 86400=24h
# RARITY_RECALC_SECONDS=21600

# How often to flush buffered aircraft_registry upserts (seconds).
# Reduces SD writes from ~100/minute to ~100 every 5 minutes at 100 live aircraft.
# REGISTRY_FLUSH_SECONDS=300

# Enable adaptive memory pressure policy (reads /proc/meminfo every 10s).
# Set false to lock to full-retention mode regardless of available RAM. (default: true)
# MEMORY_POLICY_ENABLED=true

# ---------------------------------------------------------------------------
# In-memory hi-res timelapse buffer
# ---------------------------------------------------------------------------

# How long to retain in-memory position samples in seconds. 43200 = 12 hours. (default: 43200)
# Reduce if RAM is limited (each hour of data ≈ 8–16 MB depending on traffic).
# HIRES_MAX_AGE_S=43200

# Hard cap on total in-memory position points across all aircraft. (default: 500000)
# 500k points ≈ 100–200 MB Python RSS. Reduce on constrained devices.
# HIRES_MAX_POINTS=500000

# ---------------------------------------------------------------------------
# Position quality gates (advanced — safe to leave at defaults)
# ---------------------------------------------------------------------------

# Maximum range (nm) accepted for a first local-CPR position before global pairing. (default: 300)
# ADSB_LOCAL_ENTRY_MAX_RANGE_NM=300

# Maximum implied groundspeed (knots) between consecutive positions. (default: 750)
# ADSB_MAX_IMPLIED_SPEED_KT=750

# Maximum age (seconds) of a position fix before it is considered stale for coverage. (default: 15)
# POS_FRESH_S=15

# Maximum age (seconds) of an altitude fix before it is considered stale for coverage. (default: 20)
# ALT_FRESH_S=20

# ---------------------------------------------------------------------------
# Position QA checker (debug — requires readsb running on same or remote host)
# ---------------------------------------------------------------------------

# Local path to readsb aircraft.json (for position QA tab; only read if DEBUG_LOG=true)
# READSB_AIRCRAFT_JSON_PATH=/run/readsb/aircraft.json

# Remote URL for readsb aircraft.json (used if local path is unavailable)
# READSB_AIRCRAFT_JSON_URL=http://adsbpi.local/tar1090/data/aircraft.json

# MLAT position quality and fusion mode.
# Enable only after confirming per-source diagnostics look reasonable in the UI.
# none         — default: last-write-wins, no position change
# spike_filter — reject fixes whose implied groundspeed exceeds 750 kt
# weighted     — ECEF weighted centroid of recent fixes from all active sources
# kalman       — 2-D constant-velocity Kalman filter; per-source quality scores
#                scale measurement noise so weaker sources contribute less;
#                chi-squared innovations gate rejects gross outliers automatically
# MLAT_FUSION=none

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# ntfy.sh push notifications (free, no account needed for public topics)
# NTFY_URL=https://ntfy.sh/your-unique-topic

# Email via SMTP (Gmail example: host=smtp.gmail.com, port=587, use App Password)
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=sender@example.com
# NOTIFY_SMTP_HOST=localhost
# NOTIFY_SMTP_PORT=587    # 587=STARTTLS (default), 465=SSL
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASS=

# Terrain overlay in the 3D coverage view (default: enabled).
# Disable on systems with limited storage — SRTM tiles are ~25 MB each and up
# to ~350 tiles may be downloaded for a 400 nm radius.  When disabled, the
# terrain button is hidden in the UI and no downloads or processing occur.
# TERRAIN_ENABLED=false

# Trigger switches (NOTIFY_EMERGENCY defaults true; others default false)
# Individual aircraft watchlist is managed in the Settings tab of the UI.
# NOTIFY_EMERGENCY=true
# NOTIFY_ACAS=false
# NOTIFY_MILITARY=false
# NOTIFY_INTERESTING=false
